# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.

# Public site address used for canonical links, the sitemap and share images.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# EmailJS Configuration (Used to deliver enquiries directly to your email)
# Get these from your EmailJS dashboard: https://dashboard.emailjs.com/
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional: Only needed if private key authentication is enabled in Account -> Security
EMAILJS_PRIVATE_KEY=

# Alternative: Webhook delivery (Slack, Zapier, Make, CRM)
ENQUIRY_WEBHOOK_URL=

# Optional contact details. Each appears on the site only when it is set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
